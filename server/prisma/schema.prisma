generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  roleId       String?  @db.ObjectId
  role         Role?    @relation(fields: [roleId], references: [id])
  timezone     String   @default("Europe/Stockholm")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets      Ticket[] @relation("TicketCreator")

  @@map("users")
}

model Customer {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?
  passport    String?   @unique
  nationality String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]

  @@map("customers")
}

model Airline {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  code      String    @unique
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tickets   Ticket[]
  bookings  Booking[]

  @@map("airlines")
}

model Ticket {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  passengerName          String
  email                  String   @default("")
  phone                  String   @default("")
  airlineId              String?  @db.ObjectId
  airline                Airline? @relation(fields: [airlineId], references: [id])
  flightNumber           String   @default("")
  pnr                    String   @default("")
  departureAirport       String   @default("")
  arrivalAirport         String   @default("")
  departureTimeUTC       String   @default("")
  originalTimezone       String   @default("Asia/Colombo")
  remarks                String?
  status                 String   @default("No Need Further Actions")
  checkin                Boolean  @default(false)
  remind                 Boolean  @default(false)
  returnTicket           Boolean  @default(false)
  returnLeg              Boolean  @default(false)
  returnDepartureAirport String   @default("")
  returnArrivalAirport   String   @default("")
  returnFlightNumber     String   @default("")
  returnPnr              String   @default("")
  returnDepartureTimeUTC String   @default("")
  returnOriginalTimezone String   @default("")
  thankYouSent           Boolean  @default(false)
  reminderSent           Boolean  @default(false)
  createdById            String?  @db.ObjectId
  createdBy              User?    @relation("TicketCreator", fields: [createdById], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bookings               Booking[]

  @@index([pnr])
  @@index([passengerName])
  @@index([departureTimeUTC])
  @@index([createdAt])
  @@map("tickets")
}

model Booking {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String?   @db.ObjectId
  ticket     Ticket?   @relation(fields: [ticketId], references: [id])
  customerId String?   @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id])
  airlineId  String?   @db.ObjectId
  airline    Airline?  @relation(fields: [airlineId], references: [id])
  bookingRef String?
  amount     Float?
  currency   String?   @default("EUR")
  paymentId  String?   @unique @db.ObjectId
  payment    Payment?  @relation("BookingPayment", fields: [paymentId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("bookings")
}

model Payment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  booking   Booking?  @relation("BookingPayment")
  amount    Float
  currency  String    @default("EUR")
  method    String?
  status    String?   @default("pending")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("payments")
}

model Supplier {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String    @unique
  contactEmail String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expenses     Expense[]

  @@map("suppliers")
}

model Expense {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  supplierId  String?   @db.ObjectId
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  category    String?
  amount      Float
  currency    String    @default("EUR")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("expenses")
}

model Invoice {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String    @unique
  customerName  String
  customerEmail String?
  amount        Float
  currency      String    @default("EUR")
  status        String?   @default("pending")
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("invoices")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  userName  String
  userEmail String
  action    String
  target    String   @default("")
  details   String?
  ip        String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
